rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: checks if user is authenticated with the verified owner email
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'dragonballsam86@gmail.com';
    }

    // Portfolio projects (websites, apps):
    // Public visitors can read projects to view the portfolio.
    // Only the verified admin can create, update, or delete projects.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Website settings (e.g. logoUrl):
    // Public visitors can read to load the logo.
    // Only the verified admin can modify settings.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
